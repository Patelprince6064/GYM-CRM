# Copy to `.env` and adjust for your machine.
# Frontend base URL for the API (dev proxy handles `/api` → localhost:5000).
VITE_API_URL=/api

# Backend port (used by server/src/server.js)
PORT=5000

# --- Authentication -------------------------------------------------------
# HMAC key used to sign session tokens. Must be at least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server uses an ephemeral random key: sessions are valid but
# are invalidated whenever the process restarts (fine for local dev, not for
# production). NEVER commit a real value — keep `.env` out of version control.
AUTH_SECRET=

# Optional overrides for the demo accounts seeded on first boot.
# Leave blank to use the built-in demo credentials documented in the README.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_MEMBER_PASSWORD=
